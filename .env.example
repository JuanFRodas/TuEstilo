# Puerto del servidor local
PORT=3000

# Base de datos. Vacío = archivo local data/tuestilo.db.
# En Vercel es obligatorio usar Turso (ver README, sección "Publicar en Vercel").
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google Calendar (ver README, sección "Google Calendar"):
# En local, la ruta del archivo JSON con la clave de la cuenta de servicio.
GOOGLE_CREDENCIALES=credenciales/google-calendar.json
# En Vercel, en vez del archivo, el contenido completo del JSON en GOOGLE_CREDENCIALES_JSON.
# Id del calendario donde se crean las citas (para el calendario principal es tu correo de Gmail).
GOOGLE_CALENDAR_ID=
# Si falta, las citas se guardan igual y quedan pendientes de pasar al calendario.
