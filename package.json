  },
  "homepage": "https://github.com/JuanFRodas/TuEstilo#readme",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^4.22.3",
    "google-auth-library": "^11.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5"
  }
